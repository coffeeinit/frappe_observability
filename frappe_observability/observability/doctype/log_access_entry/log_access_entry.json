    {"fieldname": "ip", "label": "IP Address", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "action", "label": "Action", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "scope", "label": "Scope", "fieldtype": "Select", "options": "site\nbench", "in_list_view": 1},
    {"fieldname": "file", "label": "Absolute Path", "fieldtype": "Small Text"},
    {"fieldname": "bytes", "label": "Bytes", "fieldtype": "Int", "default": "0"},
    {"fieldname": "outcome", "label": "Outcome", "fieldtype": "Data", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "Observability Admin", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 0, "export": 0, "print": 0, "email": 0, "share": 0},
    {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 0, "export": 0, "print": 0, "email": 0, "share": 0}
  ]
}
