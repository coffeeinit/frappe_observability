{
  "doctype": "DocType",
  "name": "Log Access Entry",
  "module": "Observability",
  "custom": 0,
  "autoname": "hash",
  "istable": 0,
  "editable_grid": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "engine": "InnoDB",
  "sort_field": "time",
