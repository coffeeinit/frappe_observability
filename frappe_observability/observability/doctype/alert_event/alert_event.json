{
  "doctype": "DocType",
  "name": "Alert Event",
  "module": "Observability",
  "custom": 0,
  "autoname": "hash",
  "istable": 0,
  "editable_grid": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "engine": "InnoDB",
  "sort_field": "fired_at",
  "sort_order": "DESC",
  "field_order": ["alert_rule", "metric_name", "status", "acknowledged", "severity", "current_value", "threshold", "fired_at", "last_notified", "resolved_at", "message", "details_json"],
  "fields": [
    {"fieldname": "alert_rule", "label": "Alert Rule", "fieldtype": "Link", "options": "Alert Rule", "in_list_view": 1},
    {"fieldname": "metric_name", "label": "Metric Name", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Open\nAcknowledged\nResolved", "default": "Open", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "acknowledged", "label": "Acknowledged", "fieldtype": "Check", "default": "0"},
    {"fieldname": "severity", "label": "Severity", "fieldtype": "Select", "options": "Info\nWarning\nCritical", "reqd": 1, "in_list_view": 1},
    {"fieldname": "current_value", "label": "Current Value", "fieldtype": "Float", "reqd": 1},
    {"fieldname": "threshold", "label": "Threshold", "fieldtype": "Float"},
    {"fieldname": "fired_at", "label": "Fired At", "fieldtype": "Datetime", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "last_notified", "label": "Last Notified", "fieldtype": "Datetime"},
    {"fieldname": "resolved_at", "label": "Resolved At", "fieldtype": "Datetime"},
    {"fieldname": "message", "label": "Message", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "details_json", "label": "Details (JSON)", "fieldtype": "Code", "options": "JSON", "description": "Do not store secrets or raw logs."}
  ],
  "permissions": [
    {"role": "Observability Viewer", "read": 1, "write": 0, "create": 0, "delete": 0, "report": 0, "export": 0, "print": 0, "email": 0, "share": 0},
    {"role": "Observability Admin", "read": 1, "write": 1, "create": 0, "delete": 0, "report": 0, "export": 0, "print": 0, "email": 0, "share": 0},
    {"role": "System Manager", "read": 1, "write": 1, "create": 0, "delete": 0, "report": 0, "export": 0, "print": 0, "email": 0, "share": 0}
  ]
}
